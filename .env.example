# 复制为 .env 或 apps/api/.env 后再改。不要把真实密钥提交进仓库。
PORT=4310
HOST=0.0.0.0

# 默认相对 apps/api 工作目录：../../data
# DATA_DIR=

# local | s3
STORAGE_DRIVER=local
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=lingjing
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# 每个重建阶段的等待毫秒。设为 0 会在一次调度里走完演示阶段。
JOB_STAGE_MS=1400
# 仅当 JOB_STAGE_MS 未设置且本值为 0 时，阶段等待也是 0（测试用）。
JOB_DELAY_MS=2200
DEMO_MERCHANT_TOKEN=demo-merchant
DEMO_CONSUMER_TOKEN=demo-consumer
DEMO_OPS_TOKEN=demo-ops
