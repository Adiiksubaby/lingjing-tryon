    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/api.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.0.3",
    "@lingjing/shared": "workspace:*",
    "@lingjing/tryon-viewer": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
