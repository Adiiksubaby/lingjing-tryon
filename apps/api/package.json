{
  "name": "@lingjing/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
